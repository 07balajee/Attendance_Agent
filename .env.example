# ── Attendance Agent POC — Environment Variables ──────────────────────────
# Copy this file to .env and fill in your values.
# These are the SAME variables as the main HRMS project .env
# so you can copy-paste from there directly.

# ── Supabase (REQUIRED) ──────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# ── Gemini (OPTIONAL) ────────────────────────────────────────────────────────
# Used by Node 5 to draft manager narratives.
# If not set, a rule-based fallback narrative is used instead.
GEMINI_API_KEY=

# ── POC Server ───────────────────────────────────────────────────────────────
POC_PORT=8001
POC_HOST=127.0.0.1

# ── Agent Tunables (optional — these are the defaults) ───────────────────────
AGENT_SLA_WARNING_DAYS=2
AGENT_SLA_BREACH_DAYS=5
AGENT_AUTO_CLOSE_HOUR=21
AGENT_ANOMALY_WINDOW_DAYS=30

# ── Safety ───────────────────────────────────────────────────────────────────
# AGENT_DRY_RUN=true  → agents READ only, nothing written to DB (safe for demo)
# AGENT_DRY_RUN=false → agents actually write to DB
AGENT_DRY_RUN=true
